# Phase 2 validation preview needs no credentials. Integrations are not wired up yet.
# Copy to .env.local when later phases need these settings.
# Never commit .env.local or paste secret values into chat.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Phase 3: Supabase (server-only; do not add NEXT_PUBLIC_ to the service key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 4: Stripe sandbox / test-mode only
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Phase 5: Resend (use a verified sender and test recipient first)
RESEND_API_KEY=
EMAIL_FROM=

# Phase 6: long random value to authorize scheduled requests
CRON_SECRET=
